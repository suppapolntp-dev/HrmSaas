{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=hrmsaas;Username=postgres;Password=postgres"
  },
  "SessionOptions": {
    "CookieName": "HrmSaas.Sid",
    "XsrfCookieName": "XSRF-TOKEN",
    "SlidingExpirationMinutes": 30,
    "AbsoluteExpirationHours": 12,
    "LastAccessedUpdateThresholdSeconds": 120,
    "RequireSecureCookie": false
  },
  "ProxyOptions": {
    "KnownProxies": [ "127.0.0.1", "::1" ],
    "KnownNetworks": []
  }
}
