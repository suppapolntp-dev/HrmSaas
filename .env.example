# PostgreSQL 16
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hrmsaas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_APP_USER=hrm_app_user
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_USER_PASSWORD

# .NET Backend API
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=8080
ASPNETCORE_HTTP_PORTS=8080
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=hrmsaas;Username=hrm_app_user;Password=CHANGE_ME_APP_USER_PASSWORD

# Session, Cookie & Reverse Proxy
SessionOptions__CookieName=HrmSaas.Sid
SessionOptions__XsrfCookieName=XSRF-TOKEN
SessionOptions__SlidingExpirationMinutes=30
SessionOptions__AbsoluteExpirationHours=12
SessionOptions__LastAccessedUpdateThresholdSeconds=120
SessionOptions__RequireSecureCookie=false
ProxyOptions__KnownProxies__0=127.0.0.1

# Frontend (Angular + Nginx)
FRONTEND_PORT=4200
API_BASE_URL=/api/v1
ENABLE_API_TOGGLE=true
